# Copie este arquivo para ".env" (mesma pasta) e preencha com os valores reais.
# O arquivo .env NAO deve ser versionado (ja esta no .gitignore).

# Token de integracao com a API Bluesoft (Cosmos)
BLUESOFT_TOKEN=CHANGE_ME

# Credenciais da area de gerencia do sistema de etiquetas
GERENCIA_USUARIO=admin
GERENCIA_SENHA=CHANGE_ME

# Chave usada para assinar o token de sessao da area de gerencia
SECRET_KEY=CHANGE_ME
